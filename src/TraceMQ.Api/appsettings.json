{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Without this the framework default of port 5000 applies, which on macOS is AirPlay
  // Receiver and on any box is a coin flip. launchSettings.json covers development and is
  // not published, so the shipped binary needs its own answer.
  // Bind to 0.0.0.0 instead of localhost to reach it from another machine on the line.
  "Urls": "http://localhost:5027",
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "tracemq",
    "Topics": [ "codeit/#" ]
  },
  "Storage": {
    "DbPath": "",
    "RetentionDays": 7,
    "BatchSize": 500,
    "FlushIntervalMs": 100
  },
  "Correlation": {
    "Paths": [ "trigger.uid" ]
  }
}
